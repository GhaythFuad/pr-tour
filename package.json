{
  "name": "pr-tour",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check-tour": "node build.mjs --checker && node bin/check-tour.mjs",
    "package": "pnpm build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "description": "Guided CodeTour reviews on GitHub pull requests, with a portable authoring skill.",
  "license": "MIT",
  "author": "Ghayth Qaralleh",
  "repository": {
    "type": "git",
    "url": "https://github.com/GhaythFuad/pr-tour.git"
  },
  "homepage": "https://github.com/GhaythFuad/pr-tour#readme",
  "bugs": {
    "url": "https://github.com/GhaythFuad/pr-tour/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.2"
}
